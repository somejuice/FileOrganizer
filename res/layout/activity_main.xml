<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/root"
    android:background="@color/bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="27.0sp"
        android:textColor="@color/textMain"
        android:id="@id/tv_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18.0dip"
        android:text="文件整理器"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="20.0dip" />
    <TextView
        android:textSize="13.0sp"
        android:textColor="@color/textSub"
        android:id="@id/tv_header_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.0dip"
        android:layout_marginBottom="2.0dip"
        android:text="按后缀自动归类 · 后台常驻监控"
        android:layout_marginStart="20.0dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/card_perm"
        style="@style/Card">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <TextView
                android:text="权限状态"
                style="@style/CardTitle" />
            <TextView
                android:id="@id/tv_perm_status"
                android:layout_marginTop="2.0dip"
                android:text="检查中…"
                style="@style/CardSub" />
        </LinearLayout>
        <Button
            android:id="@id/btn_perm"
            android:text="授权"
            style="@style/BtnTonal" />
    </LinearLayout>
    <LinearLayout
        android:id="@id/card_dir"
        style="@style/Card">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:text="监控目录"
                    style="@style/CardTitle" />
                <TextView
                    android:ellipsize="middle"
                    android:id="@id/tv_dir"
                    android:layout_marginTop="2.0dip"
                    android:text="未设置"
                    android:singleLine="true"
                    style="@style/CardSub" />
            </LinearLayout>
            <Button
                android:id="@id/btn_pick_dir"
                android:text="选择目录"
                style="@style/BtnFilled" />
        </LinearLayout>
        <TextView
            android:layout_marginTop="8.0dip"
            android:text="通过目录浏览器选择；分类文件夹默认创建在此目录内"
            style="@style/CardSub" />
    </LinearLayout>
    <LinearLayout
        android:id="@id/card_service"
        style="@style/Card">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:text="后台常驻整理"
                    style="@style/CardTitle" />
                <TextView
                    android:layout_marginTop="2.0dip"
                    android:text="实时监控目录变化并自动移动文件"
                    style="@style/CardSub" />
            </LinearLayout>
            <Switch
                android:id="@id/sw_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip">
            <TextView
                android:layout_width="0.0dip"
                android:text="定时全量备份扫描"
                android:layout_weight="1.0"
                style="@style/CardSub" />
            <Spinner
                android:id="@id/sp_interval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown" />
        </LinearLayout>
        <Button
            android:id="@id/btn_scan_now"
            android:layout_width="fill_parent"
            android:layout_marginTop="12.0dip"
            android:text="立即整理一次"
            style="@style/BtnFilled" />
    </LinearLayout>
    <LinearLayout
        android:id="@id/card_rules"
        android:layout_weight="1.0"
        style="@style/Card">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="0.0dip"
                android:text="整理规则（后缀 → 文件夹）"
                android:layout_weight="1.0"
                style="@style/CardTitle" />
            <Button
                android:textColor="@color/textSub"
                android:id="@id/btn_default_rules"
                android:text="恢复默认"
                style="@style/BtnText" />
            <Button
                android:id="@id/btn_add_rule"
                android:text="＋添加"
                style="@style/BtnText" />
        </LinearLayout>
        <TextView
            android:layout_marginTop="4.0dip"
            android:text="点按编辑 · 长按删除 · 目标文件夹可浏览选择"
            style="@style/CardSub" />
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_marginTop="6.0dip"
            android:layout_weight="1.0">
            <ListView
                android:id="@id/lv_rules"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:divider="@null"
                android:dividerHeight="0.0dip" />
            <TextView
                android:textSize="13.0sp"
                android:textColor="@color/textSub"
                android:layout_gravity="center"
                android:id="@id/tv_rules_empty"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无规则，点击右上角“＋添加”" />
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textSize="13.0sp"
        android:textColor="@color/onPrimaryContainer"
        android:gravity="center"
        android:id="@id/tv_stats"
        android:background="@drawable/bg_stat_pill"
        android:padding="13.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:layout_marginBottom="14.0dip"
        android:text="累计整理 0 个文件 · 点击查看记录"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="14.0dip"
        android:layout_marginEnd="14.0dip" />
</LinearLayout>