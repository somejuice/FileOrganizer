<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>
    </style>
    <style name="BtnFilled">
        <item name="android:textSize">14.0sp</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:background">@drawable/bg_btn_filled</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0.0dip</item>
        <item name="android:minHeight">42.0dip</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">20.0dip</item>
        <item name="android:paddingEnd">20.0dip</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="BtnText">
        <item name="android:textSize">13.0sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:background">?android:selectableItemBackgroundBorderless</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0.0dip</item>
        <item name="android:minHeight">36.0dip</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">8.0dip</item>
        <item name="android:paddingEnd">8.0dip</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="BtnTonal">
        <item name="android:textSize">13.0sp</item>
        <item name="android:textColor">@color/onPrimaryContainer</item>
        <item name="android:background">@drawable/bg_btn_tonal</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0.0dip</item>
        <item name="android:minHeight">38.0dip</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16.0dip</item>
        <item name="android:paddingEnd">16.0dip</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Card">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16.0dip</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10.0dip</item>
        <item name="android:layout_marginStart">14.0dip</item>
        <item name="android:layout_marginEnd">14.0dip</item>
    </style>
    <style name="CardSub">
        <item name="android:textSize">13.0sp</item>
        <item name="android:textColor">@color/textSub</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="CardTitle">
        <item name="android:textSize">15.0sp</item>
        <item name="android:textColor">@color/textMain</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
